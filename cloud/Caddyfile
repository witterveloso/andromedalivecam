{$CAM_DOMAIN} {
  header {
    Referrer-Policy "no-referrer"
    X-Content-Type-Options "nosniff"
  }
  request_body {
    max_size 8KB
  }
  # Ponto de encontro da Rede Andrômeda (WebSocket)
  handle /mqtt {
    reverse_proxy host.docker.internal:8090
  }
  handle {
    reverse_proxy gateway:8080
  }
}
